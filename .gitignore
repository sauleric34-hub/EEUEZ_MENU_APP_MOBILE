# ═══════════════════════════════════════════════════════════
#  .gitignore — Menu (backend Django + app Expo/React Native)
# ═══════════════════════════════════════════════════════════

# ─── Secrets & environnement (NE JAMAIS COMMITTER) ───────────
# Les vrais secrets vivent dans les variables d'environnement du serveur.
# Seul .env.example (sans valeurs) est versionné.
.env
.env.*
!.env.example
*.env
backend/.env

# ─── Python / Django ─────────────────────────────────────────
# Les fichiers compilés (.pyc / __pycache__) ne doivent JAMAIS être versionnés :
# ils sont régénérés à chaque exécution et polluent les diffs. S'ils réapparaissent
# dans `git status`, c'est qu'ils sont encore suivis → `git rm -r --cached <chemin>`.
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Environnements virtuels
venv/
.venv/
env/
ENV/
virtualenv/

# Base de données locale (SQLite)
db.sqlite3
db.sqlite3-journal
backend/**/*.sqlite3
backend/data/*.db

# Fichiers générés / uploadés (ne pas versionner)
backend/media/
backend/staticfiles/
backend.zip

# ─── Node / Expo / React Native ──────────────────────────────
node_modules/
eeuez-expo-ui/node_modules/
.expo/
.expo-shared/
web-build/

# Clés de signature d'app (ne JAMAIS versionner)
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision

# ─── Tests & couverture ──────────────────────────────────────
.coverage
htmlcov/
/coverage/
.pytest_cache/

# ─── Logs ────────────────────────────────────────────────────
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Éditeurs / IDE ──────────────────────────────────────────
.idea/
*.iml
*.swp
*.swo
.history/
# .vscode/ laissé versionnable (config partagée) ;
# décommenter la ligne suivante pour l'ignorer :
# .vscode/

# ─── Node ────────────────────────────────────────────────────
node_modules/

# ─── Outillage local Claude Code ─────────────────────────────
.claude/

# ─── Réglages Django de prévisualisation locale (non versionnés) ─
backend/backend/preview_settings.py
