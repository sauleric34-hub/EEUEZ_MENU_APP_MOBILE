# ═══════════════════════════════════════════════════════════════
#  EEUEZ Menu — variables d'environnement du backend
#  Copiez ce fichier en « .env » (dev) OU définissez ces variables
#  dans l'interface cPanel (prod). NE COMMITTEZ JAMAIS le .env réel.
# ═══════════════════════════════════════════════════════════════

# ─── Django ──────────────────────────────────────────────────────
# Générez une clé unique : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-long-random-value
# Prod : DEBUG=False impérativement.
DEBUG=True
# Hôtes autorisés en prod (séparés par des virgules).
ALLOWED_HOSTS=menu.cambus.cm,www.menu.cambus.cm
# Origines CORS/CSRF de confiance en prod (séparées par des virgules).
CORS_ALLOWED_ORIGINS=https://menu.cambus.cm
CSRF_TRUSTED_ORIGINS=https://menu.cambus.cm

# ─── Base de données MySQL (cPanel) ──────────────────────────────
DB_NAME=ch6973134ef1cfd_menu
DB_USER=ch6973134ef1cfd_yan
# Mot de passe DB — obligatoire. À FAIRE TOURNER (l'ancien a fuité dans Git).
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ─── Monetbil ────────────────────────────────────────────────────
MONETBIL_SERVICE_KEY=
MONETBIL_SERVICE_SECRET=
APP_BASE_URL=https://menu.cambus.cm
# Vérifier la signature des notifications Monetbil — À ACTIVER EN PROD.
MONETBIL_VERIFY_SIGN=True

# ─── Monetbil décaissement (payout) — optionnel ──────────────────
MONETBIL_PAYOUT_ENABLED=False
MONETBIL_PAYOUT_URL=https://api.monetbil.com/payout/v1
