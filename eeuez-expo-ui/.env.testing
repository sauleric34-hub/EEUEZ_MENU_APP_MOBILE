# ===== ENVIRONNEMENT TESTING =====
# Utilisé pour les tests en ligne (staging/VPS)
# Backend Django déployé sur serveur de test

EXPO_PUBLIC_API_URL=https://eeuez-menu-testing.onrender.com/api
EXPO_PUBLIC_WS_URL=wss://eeuez-menu-testing.onrender.com/ws
EXPO_PUBLIC_ENV=testing

# Auth JWT
EXPO_PUBLIC_JWT_ACCESS_TOKEN_LIFETIME=60
EXPO_PUBLIC_JWT_REFRESH_TOKEN_LIFETIME=1

# Debug
EXPO_PUBLIC_DEBUG=true
