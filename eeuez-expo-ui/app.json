{
  "expo": {
    "name": "Menu",
    "slug": "menu",
    "version": "1.0.0",
    "scheme": "menu",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080c09"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.app.menu"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080c09",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.app.menu"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Menu utilise votre position pour vous recommander les meilleurs plats et restaurants les plus proches, et réduire vos frais de livraison."
        }
      ]
    ]
  }
}