{
  "expo": {
    "name": "Menu",
    "slug": "menu",
    "version": "1.0.0",
    "scheme": "menu",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080c09"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.app.menu"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.app.menu",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Menu utilise votre position pour vous recommander les meilleurs plats et restaurants les plus proches, et réduire vos frais de livraison."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Menu accède à vos photos pour joindre une image à vos messages avec les restaurants."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Menu utilise la caméra pour scanner le QR code du livreur et confirmer la réception de votre commande."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9443cdd-1292-496d-bf81-9d7dc58a5bff"
      }
    }
  }
}
